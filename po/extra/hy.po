msgid "Minor Updates:"
msgstr "Փոքր թարմացումներ՝"

#: data/notifications.metainfo.xml.in:40 data/notifications.metainfo.xml.in:52
#: data/notifications.metainfo.xml.in:65 data/notifications.metainfo.xml.in:80
