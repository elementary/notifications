#: data/notifications.metainfo.xml.in:62
msgid "Block GSD \"Automatic Suspend\" notifications"
msgstr "Արգելափակվել են GSD-ի «Ավտոմատ կասեցում» ծանուցումները"

#: data/notifications.metainfo.xml.in:77
msgid ""
"Increase sound and brightness notifications width to match other "
"notifications"
msgstr ""
"Ձայնի և պայծառության ծանուցումների լայնությունը մեծացվել է՝ մյուս "
"ծանուցումներին համապատասխանելու համար"

#: data/notifications.metainfo.xml.in:103
msgid "Fix missing icon when set from icon name"
msgstr "Շտկվել է բացակայող պատկերակը, երբ այն սահմանված է պատկերակի անունով"
