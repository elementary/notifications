msgstr "Ծանուցումներ"

#: data/notifications.metainfo.xml.in:11
msgid "Notification bubbles and sounds for the desktop"
msgstr "Ծանուցման ամպիկներ և ձայներ աշխատասեղանի համար"

#: data/notifications.metainfo.xml.in:13
msgid "A notification server for Pantheon"
